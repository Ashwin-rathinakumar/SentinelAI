# Disabled by default: inference never requires a blockchain.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_WRITER_PRIVATE_KEY=
# Generate a random key with at least 32 bytes; never commit it.
BLOCKCHAIN_AUDIT_HMAC_KEY=
BLOCKCHAIN_AUDIT_HMAC_KEY_ID=local-v1
BLOCKCHAIN_RPC_TIMEOUT=3
BLOCKCHAIN_RECEIPT_TIMEOUT=15
# PostgreSQL example. SQLite remains the default when DATABASE_URL is unset.
DATABASE_URL=postgresql+psycopg://sentinelai:change-me@127.0.0.1:5432/sentinelai
